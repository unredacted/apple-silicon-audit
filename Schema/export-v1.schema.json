{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/unredacted/apple-silicon-audit/Schema/export-v1.schema.json",
  "title": "Silicon Audit export, schema 1.x",
  "description": "One device's audit result. additionalProperties is false everywhere: the schema is also the privacy allowlist enforced by CI.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "app_version", "collected_at", "collection", "environment", "device", "facts", "unrecognized_keys"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "app_version": { "type": "string" },
    "variant": { "type": "string", "enum": ["full", "compact"], "default": "full" },
    "collected_at": { "type": "string", "format": "date-time" },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["walk_succeeded", "walk_root", "known_keys_version"],
      "properties": {
        "walk_succeeded": { "type": "boolean" },
        "walk_root": { "type": "string", "const": "hw.optional" },
        "walk_failure": { "type": ["string", "null"] },
        "known_keys_version": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "arch", "os_version", "os_build", "kernel_version", "is_simulator", "is_translated", "is_ios_app_on_mac", "is_catalyst"],
      "properties": {
        "platform": { "type": "string", "enum": ["iOS", "iPadOS", "macOS", "watchOS", "tvOS", "visionOS", "unknown"] },
        "arch": { "type": "string", "enum": ["arm64", "arm64e", "x86_64", "unknown"] },
        "os_version": { "type": "string" },
        "os_build": { "type": "string" },
        "kernel_version": { "type": "string" },
        "is_simulator": { "type": "boolean" },
        "is_translated": { "type": "boolean" },
        "is_ios_app_on_mac": { "type": "boolean" },
        "is_catalyst": { "type": "boolean" }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hw_product", "hw_machine", "hw_model", "cpufamily", "cpufamily_name", "soc_id", "soc_name_inferred", "marketing_name_inferred"],
      "properties": {
        "hw_product": { "type": ["string", "null"] },
        "hw_machine": { "type": ["string", "null"] },
        "hw_model": { "type": ["string", "null"] },
        "hw_target": { "type": ["string", "null"] },
        "cpufamily": { "type": ["string", "null"], "pattern": "^0x[0-9a-f]{8}$" },
        "cpufamily_name": { "type": "string" },
        "cpusubfamily": { "type": ["integer", "null"] },
        "cpusubfamily_name": { "type": "string" },
        "soc_id": { "type": ["string", "null"], "pattern": "^T[0-9]{4,5}$" },
        "soc_name_inferred": { "type": "string" },
        "soc_inference_confidence": { "type": "string", "enum": ["verified", "reported", "none"] },
        "marketing_name_inferred": { "type": "string" }
      }
    },
    "facts": {
      "type": "array",
      "items": { "$ref": "#/$defs/fact" }
    },
    "unrecognized_keys": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "format", "length"],
        "properties": {
          "key": { "type": "string", "pattern": "^hw\\.optional\\." },
          "format": { "type": ["string", "null"] },
          "length": { "type": "integer", "minimum": 0 },
          "value": { "type": ["integer", "string", "null"] },
          "value_hex": { "type": "string", "pattern": "^[0-9a-f]*$" },
          "masked": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "state": {
      "type": "string",
      "enum": ["present", "not_present", "key_absent", "restricted", "error", "unknown"]
    },
    "provenance": {
      "type": "string",
      "enum": ["measured", "documented", "inferred", "unknown"]
    },
    "kind": {
      "type": "string",
      "enum": ["flag", "count", "bitmask", "string", "claim"]
    },
    "raw": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "format", "length", "errno"],
      "properties": {
        "key": { "type": "string" },
        "format": { "type": ["string", "null"] },
        "length": { "type": "integer", "minimum": 0 },
        "value": { "type": ["integer", "string", "null"] },
        "value_hex": { "type": "string", "pattern": "^[0-9a-f]*$" },
        "errno": { "type": ["integer", "null"] },
        "masked": { "type": "boolean" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "published", "verified"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "published": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "verified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "note": { "type": "string" }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name", "category", "provenance", "state"],
      "properties": {
        "id": { "type": "string" },
        "display_name": { "type": "string" },
        "category": { "type": "string" },
        "kind": { "$ref": "#/$defs/kind" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "state": { "$ref": "#/$defs/state" },
        "discovered_by": { "type": "string", "enum": ["walk", "known_list", "both"] },
        "raw": { "$ref": "#/$defs/raw" },
        "source": { "$ref": "#/$defs/source" },
        "reasoning": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "provenance": { "const": "measured" } } },
          "then": { "required": ["raw", "discovered_by"] }
        },
        {
          "if": { "properties": { "provenance": { "const": "documented" } } },
          "then": { "required": ["source"] }
        },
        {
          "if": { "properties": { "provenance": { "const": "inferred" } } },
          "then": { "required": ["reasoning"] }
        }
      ]
    }
  }
}
